{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crossfire-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "PublicRoom" }] },
  "exports": { "PublicRoom": { "type": "durable-object", "storage": "sqlite" } },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180,http://localhost:4176,http://127.0.0.1:4176,https://goofykings.github.io,http://127.0.0.1:5173",
    "SESSION_GRACE_MS": "15000",
    "HEARTBEAT_TIMEOUT_MS": "10000"
  }
}
