{
  "name": "crossfire-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run build && node --test --test-concurrency=1 tests/integration.mjs tests/combat.mjs"
  },
  "devDependencies": {
    "wrangler": "4.152.0",
    "typescript": "7.0.2",
    "miniflare": "5.20261019.2-beta",
    "ws": "8.22.0"
  }
}
