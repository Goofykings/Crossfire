{
  "name": "crossfire",
  "private": true,
  "version": "0.1.0",
  "description": "Crossfire — a 3D browser first-person shooter built with Babylon.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node tools/run-blender.mjs",
    "assets:player": "node tools/run-blender.mjs --player",
    "assets:verify": "node tools/verify-assets.mjs",
    "layout:plan": "python -I tools/layout_design.py && python -I tools/plan_overlay.py"
  },
  "dependencies": {
    "@babylonjs/core": "^9.32.0",
    "@babylonjs/loaders": "^9.32.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^24.19.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
